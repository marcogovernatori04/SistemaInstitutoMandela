<UserControl x:Class="SistemaInstituto.Views.PagosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ut="clr-namespace:SistemaInstituto.Utilities"
             xmlns:local="clr-namespace:SistemaInstituto.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:vm="clr-namespace:SistemaInstituto.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PagosViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1025"
             FontFamily="Bahnschrift">

    <UserControl.Resources>
        <ut:EnumToBoolean x:Key="EnumToBoolean"/>
        <ut:EnumToVisibility x:Key="EnumToVisibility"/>
        <ut:BoolToVisibility x:Key="BoolToVisibility"/>
        <ut:ArancelColorConverter x:Key="ArancelColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Listado de pagos"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       VerticalAlignment="Center"
                       Grid.Column="0"/>

            <Button Content="Agregar pago"
                    Command="{Binding SeleccionarPagoCommand}"
                    Width="180"
                    Height="30"
                    FontSize="16"
                    Margin="0,0,0,10"
                    Grid.Column="1"/>
        </Grid>

        <!-- Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Alumno" FontSize="14"/>
                <TextBox Width="180" FontSize="16"
                         Text="{Binding FiltroAlumno, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Curso" FontSize="14"/>
                <ComboBox Width="180" FontSize="16"
                          ItemsSource="{Binding Cursos}"
                          SelectedItem="{Binding CursoSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Método de pago" FontSize="14"/>
                <ComboBox Width="180" FontSize="16"
                          ItemsSource="{Binding MetodosPago}"
                          SelectedItem="{Binding MetodoPagoSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0"
                        Visibility="{Binding MostrarComboProfesores, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Profesor" FontSize="14"/>
                <ComboBox Width="150" FontSize="16"
                          ItemsSource="{Binding Profesores}"
                          SelectedItem="{Binding ProfesorSeleccionado, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Fecha" FontSize="14"/>
                <ComboBox ItemsSource="{Binding Meses}"
                          SelectedItem="{Binding MesSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                          Width="120" FontSize="16"/>
            </StackPanel>
        </StackPanel>

        <!-- Tabla -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding PagosView}" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Alumno" Binding="{Binding IdAlumnoNavigation.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Curso" Binding="{Binding IdAlumnoNavigation.IdCursoNavigation.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Arancel" Binding="{Binding IdArancelNavigation.Concepto}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding IdArancelNavigation.Concepto, Converter={StaticResource ArancelColorConverter}}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="SizeToHeader"/>
                <DataGridTextColumn Header="Monto" Binding="{Binding MontoPagado, StringFormat={}{0:C0}}" Width="SizeToHeader"/>
                <DataGridTextColumn Header="Método de pago" Binding="{Binding IdMetodoPagoNavigation.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="ToolTip" Value="{Binding Notas}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <!-- Estilo de fila con menú contextual -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource GlobalDataGridRow}">
                    <Setter Property="Tag"
                            Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Eliminar"
                                          Command="{Binding PlacementTarget.Tag.EliminarPagoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding .}"/>
                                <MenuItem Header="Ver factura"
                                          Command="{Binding PlacementTarget.Tag.VerFacturaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding .}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Pie con totales -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding CantRegistros, StringFormat='Cantidad de registros: {0}'}" 
                       FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding TotalMontos, StringFormat='Total montos: {0:C0}'}"
                       FontSize="18" FontWeight="SemiBold"
                       Margin="40,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
