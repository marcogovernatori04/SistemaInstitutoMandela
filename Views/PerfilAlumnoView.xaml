<Window x:Class="SistemaInstituto.Views.PerfilAlumnoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels"
        xmlns:ut="clr-namespace:SistemaInstituto.Utilities"
        d:DataContext="{d:DesignInstance Type=viewmodels:PerfilAlumnoViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Perfil del alumno"
        Width="900" Height="768"
        MinWidth="400" MinHeight="700"
        Background="#FAFAFA"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="BrushDefault" Color="#FFBFBFBF"/>
        <SolidColorBrush x:Key="BrushHighlight" Color="#27A599"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nombre del alumno -->
        <TextBlock Text="{Binding Nombre}" FontSize="24" FontWeight="SemiBold" 
                   Margin="0,0,0,12" Background="#EBEBEB" Padding="6" TextWrapping="Wrap"/>

        <!-- Información general -->
        <Grid Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Curso y Estado -->
            <Border Background="#8BE4DB" CornerRadius="6" Padding="8" VerticalAlignment="Center" MinWidth="120">
                <StackPanel>
                    <TextBlock Text="{Binding Curso}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Estado}" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="Activo">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Teléfono y Notas -->
            <Border Grid.Column="1" Background="LightGray" Margin="10,0,0,0" Width="300"
                    CornerRadius="6" Padding="5" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Telefono, StringFormat='Teléfono: {0}'}" Padding="2" FontSize="14"/>
                    <TextBlock Text="{Binding Notas, StringFormat='Notas: {0}'}" Padding="2" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Beneficio -->
            <Border Background="#EBEBEB" CornerRadius="6" Padding="8" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="2">
                <TextBlock FontSize="16" FontWeight="Medium">
                    <Run Text="Beneficio: " Foreground="Black"/>
                    <Run x:Name="DefinicionRun" Text="{Binding ExistenciaBeneficio, Mode=OneWay}"/>
                </TextBlock>

                <Border.Resources>
                    <Style TargetType="Run">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExistenciaBeneficio}" Value="No">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExistenciaBeneficio}" Value="Sí (aplica)">
                                <Setter Property="Foreground" Value="Green"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExistenciaBeneficio}" Value="Sí (no aplica)">
                                <Setter Property="Foreground" Value="Orange"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
            </Border>

            <!-- Botón editar -->
            <Button Content="Editar alumno" Width="150" Height="50" FontSize="16" 
                    Command="{Binding EditarAlumnoCommand}" HorizontalAlignment="Right" Grid.Column="2"/>
        </Grid>

        <!-- Pagos del alumno con Scroll -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#BFBFBF" Padding="8">
                <DataGrid ItemsSource="{Binding Pagos}" AutoGenerateColumns="False" 
                          HeadersVisibility="Column" ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Concepto" Binding="{Binding IdArancelNavigation.Concepto}" />
                        <DataGridTextColumn Header="Método de pago" Binding="{Binding IdMetodoPagoNavigation.Nombre}" Width="SizeToHeader"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}" />
                        <DataGridTextColumn Header="Mes" Binding="{Binding Concepto}" />
                        <DataGridTextColumn Header="Monto" Binding="{Binding MontoPagado, StringFormat={}{0:C0}}" />
                        <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
