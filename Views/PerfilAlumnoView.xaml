<Window x:Class="SistemaInstituto.Views.PerfilAlumnoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaInstituto.Views"
        xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels"
        xmlns:ut="clr-namespace:SistemaInstituto.Utilities" d:DataContext="{d:DesignInstance Type=viewmodels:PerfilAlumnoViewModel}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Perfil del alumno" Height="768" Width="1024"
        Background="#FAFAFA"
        FontFamily="Bahnschrift">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="BrushDefault" Color="#FFBFBFBF"/>
        <SolidColorBrush x:Key="BrushHighlight" Color="#27A599"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Nombre}" FontSize="24" FontWeight="SemiBold" 
                   Margin="0,0,0,12" Background="#EBEBEB" Padding="6" />

        <Grid Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#8BE4DB" CornerRadius="6" Padding="8" VerticalAlignment="Center" MinWidth="120">
                <StackPanel>
                    <TextBlock Text="{Binding Curso}" FontSize="20" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Estado}" FontSize="16" FontWeight="Medium" 
                       HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="Activo">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>


            <Border Grid.Column="1" Background="LightGray" Margin="10,0,0,0" Width="300"
                    CornerRadius="6" Padding="5" VerticalAlignment="Center">
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="{Binding Telefono, StringFormat='Teléfono: {0}'}" 
                             Padding="2" FontSize="14"/>
                    <TextBlock Text="{Binding Notas, StringFormat='Notas: {0}'}"
                             Padding="2" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>


            <Border Background="#EBEBEB"
                    CornerRadius="6"
                    Padding="8"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Grid.Column="2">

                <TextBlock FontSize="16" FontWeight="Medium">
                    <Run Text="Beneficio: " Foreground="Black"/>
                    <Run x:Name="DefinicionRun"
                         Text="{Binding ExistenciaBeneficio, Mode=OneWay}" />
                </TextBlock>

                <Border.Resources>
                    <Style TargetType="Run">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExistenciaBeneficio}" Value="No">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ExistenciaBeneficio}" Value="Sí (aplica)">
                                <Setter Property="Foreground" Value="Green"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ExistenciaBeneficio}" Value="Sí (no aplica)">
                                <Setter Property="Foreground" Value="Orange"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
            </Border>

            <Button Content="Editar alumno" Width="150" Height="50" FontSize="16" 
                    Command="{Binding EditarAlumnoCommand}"
                    HorizontalAlignment="Right" Grid.Column="2"/>
        </Grid>

        <Border Grid.Row="2" CornerRadius="10" BorderThickness="1" BorderBrush="#BFBFBF" Padding="8">
            <DataGrid ItemsSource="{Binding Pagos}" AutoGenerateColumns="False" 
                      HeadersVisibility="Column" ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding IdArancelNavigation.Concepto}" />
                    <DataGridTextColumn Header="Método de pago" Binding="{Binding IdMetodoPagoNavigation.Nombre}" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}" />
                    <DataGridTextColumn Header="Mes" Binding="{Binding Concepto}" />
                    <DataGridTextColumn Header="Monto" Binding="{Binding MontoPagado, StringFormat={}{0:C0}}" />
                    <DataGridTextColumn Header="Observaciones" Binding="{Binding Notas}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>

