<Window x:Class="SistemaInstituto.Views.FormPagoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaInstituto.Views" 
        xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels" 
        xmlns:ut="clr-namespace:SistemaInstituto.Utilities" 
        d:DataContext="{d:DesignInstance Type=viewmodels:FormPagoViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        FontFamily="Bahnschrift"
        Title="Carga de pago" Height="800" Width="450">

    <Window.Resources>
        <ut:BoolToVisibility x:Key="BoolToVisibility"/>
        <ut:NullToBool x:Key="NullToBool"/>
        <ut:SaldoColorConverter x:Key="SaldoColorConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Agregar un pago" 
                   FontSize="24" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <!-- Alumno -->
            <TextBlock Text="Alumno" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding Alumnos}" 
                          SelectedItem="{Binding AlumnoSeleccionado, Mode=TwoWay}" 
                          DisplayMemberPath="Nombre"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          FontSize="14"/>
            </Border>

            <!-- Curso y Beneficio -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Curso: " FontSize="16" Margin="0,0,10,0" Grid.Column="0"/>
                <TextBlock Text="{Binding AlumnoSeleccionado.IdCursoNavigation.Nombre}" 
                           FontSize="16" 
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Foreground="#27A599"/>

                <TextBlock Text="Beneficio: " FontSize="16" Margin="20,0,10,0" Grid.Column="2"/>
                <TextBlock Text="{Binding ExistenciaBeneficio}" 
                           FontSize="16" 
                           Grid.Column="3"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Fecha de pago -->
            <TextBlock Text="Fecha de pago" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <DatePicker SelectedDate="{Binding FechaPago, Mode=TwoWay}" FontSize="14"/>
            </Border>

            <!-- Arancel -->
            <TextBlock Text="Arancel" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding Aranceles}" 
                          SelectedItem="{Binding ArancelSeleccionado, Mode=TwoWay}" 
                          IsEnabled="{Binding AlumnoSeleccionado, Converter={StaticResource NullToBool}}"
                          DisplayMemberPath="Concepto"
                          FontSize="14"/>
            </Border>

            <!-- Totales -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Monto sugerido: " FontSize="16"/>
                <TextBlock Text="{Binding MontoOriginal, StringFormat={}{0:C}}"
                           FontSize="16"
                           Foreground="Gray"
                           TextDecorations="Strikethrough"
                           Visibility="{Binding EsDescontada, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding MontoSugerido, StringFormat={}{0:C}}"
                           Margin="5,0,0,0"
                           FontSize="16" 
                           FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Saldo actual: " FontSize="16"/>
                <TextBlock Text="{Binding SaldoVisual, StringFormat={}{0:C}}" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="{Binding SaldoVisual, Converter={StaticResource SaldoColorConverter}}"/>
            </StackPanel>

            <!-- Monto abonado -->
            <TextBlock Text="Monto abonado" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding MontoPagado, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                         FontSize="14"/>
            </Border>

            <!-- Concepto -->
            <TextBlock Text="Concepto" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>
            </Border>

            <!-- Método de Pago -->
            <TextBlock Text="Método de Pago" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding MetodosPago}" 
                          SelectedItem="{Binding MetodoPagoSeleccionado, Mode=TwoWay}"
                          IsEnabled="{Binding AlumnoSeleccionado, Converter={StaticResource NullToBool}}"
                          DisplayMemberPath="Nombre"
                          FontSize="14"/>
            </Border>

            <!-- Notas -->
            <TextBlock Text="Notas" FontSize="16" Margin="0,0,0,5"/>
            <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1">
                <TextBox Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap"
                         />
            </Border>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar" 
                    Command="{Binding GuardarCommand}" 
                    Width="100" Height="38"
                    Style="{StaticResource BotonGuardar}"
                    Margin="0,0,10,0"/>
            <Button Content="Cancelar"
                    Width="100" Height="38"
                    Background="#EBEBEB" 
                    Foreground="Black" 
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="Cancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
