<Window x:Class="SistemaInstituto.Views.FormCursoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:FormCursoViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Carga de curso"
        Width="420" Height="300"
        Background="#FAFAFA"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="{Binding Titulo}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Campos -->
        <StackPanel Grid.Row="1">

            <!-- Nombre -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Nombre" FontSize="16" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="8" Padding="6" BorderBrush="#DDD" BorderThickness="1">
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             HorizontalAlignment="Stretch"/>
                </Border>
            </StackPanel>

            <!-- Admite beneficio -->
            <CheckBox Content="Admite beneficio"
                      IsChecked="{Binding AdmiteBeneficio, Mode=TwoWay}"
                      FontSize="14"
                      Margin="0,0,0,12"/>

        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar"
                    Command="{Binding GuardarCommand}"
                    Width="100" Height="38"
                    Style="{StaticResource BotonGuardar}"
                    Margin="0,0,10,0"/>
            <Button Content="Cancelar"
                    Width="100" Height="38"
                    Click="Cancelar_Click"/>
        </StackPanel>

    </Grid>
</Window>