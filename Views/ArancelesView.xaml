<UserControl x:Class="SistemaInstituto.Views.ArancelesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ArancelesViewModel}"
             mc:Ignorable="d" 
             FontFamily="Bahnschrift"
             d:DesignHeight="800" d:DesignWidth="1025">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0">
            <TextBlock Text="Listado de aranceles"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <Button Content="Actualizar aranceles"
                    MinWidth="160"
                    Height="35"
                    FontSize="16"
                    Command="{Binding AgregarArancelCommand}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Margin="10,0,0,0"/>
        </DockPanel>

        <!-- Filtros -->
        <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10" ItemHeight="35">
            <TextBlock Text="Filtrar por curso:" 
                       Margin="5,0"
                       VerticalAlignment="Center"
                       FontSize="16"/>
            <ComboBox DisplayMemberPath="Nombre"
                      SelectedItem="{Binding CursoFiltrado, Mode=TwoWay}"
                      ItemsSource="{Binding Cursos}"
                      Width="200"
                      FontSize="16"
                      Margin="5,0"/>
            <CheckBox Content="Ver inactivos"
                      Command="{Binding ToggleInactivosCommand}"
                      Margin="10,0,0,0"
                      FontSize="16"
                      VerticalAlignment="Center"/>
        </WrapPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ArancelesView}"
                  AutoGenerateColumns="False"
                  Margin="0,5,0,0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Curso" Binding="{Binding IdCursoNavigation.Nombre}" Width="1.5*"/>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="2*"/>
                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C0}}" Width="1*"/>
                <DataGridTextColumn Header="Vigencia desde" Binding="{Binding VigenciaDesde, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>
                <DataGridTextColumn Header="Vigencia hasta" Binding="{Binding VigenciaHasta, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>

                <!-- Activo con colores -->
                <DataGridTemplateColumn Header="Activo" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                       Style="{StaticResource ActivoTextBlockStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
