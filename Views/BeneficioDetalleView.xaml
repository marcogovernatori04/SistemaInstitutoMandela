<Window x:Class="SistemaInstituto.Views.BeneficioDetalleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:BeneficioDetalleViewModel}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Detalle del beneficio" Height="450" Width="500"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="BrushDefault" Color="#FFBFBFBF"/>
        <SolidColorBrush x:Key="BrushHighlight" Color="#27A599"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="{Binding BeneficioNombre}"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Listado de alumnos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Alumnos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                BorderThickness="1.5"
                                BorderBrush="{StaticResource BrushDefault}">
                            <StackPanel>
                                <!-- Encabezado alumno -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"
                                               FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="SemiBold"/>
                                    <Border Background="{StaticResource BrushHighlight}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0"
                                            Visibility="{Binding EsConDescuento, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Beneficio" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Curso -->
                                <TextBlock Text="{Binding Curso}" Foreground="Gray" FontSize="15" Margin="0,4,0,8"/>

                                <!-- Cuotas -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="Cuota base: " FontWeight="Bold" FontSize="15" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding CuotaBase, StringFormat='{}{0:C}'}"
                                               Foreground="DarkGray" FontSize="14" Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding EsConDescuento, Converter={StaticResource BoolToVisibility}}"
                                               TextDecorations="Strikethrough"/>
                                    <TextBlock Text="{Binding CuotaFinal, StringFormat='{}{0:C}'}"
                                               FontSize="16" FontWeight="SemiBold" Margin="4,0,0,0"
                                               Foreground="{StaticResource BrushHighlight}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Editar beneficio"
                Command="{Binding EditarBeneficioCommand}"
                HorizontalAlignment="Right"
                Width="160" Height="32"
                Margin="0,12,0,0"/> 
    </Grid>
</Window>
