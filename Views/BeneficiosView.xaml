<UserControl x:Class="SistemaInstituto.Views.BeneficiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SistemaInstituto.Views"
             mc:Ignorable="d" 
             FontFamily="Bahnschrift"
             d:DesignHeight="800" d:DesignWidth="1025">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Listado de beneficios"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Grid.Column="0"/>

            <Button Content="Agregar beneficio"
                    Command="{Binding AgregarBeneficioCommand}"
                    Width="180"
                    FontSize="16"
                    Height="30"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Grid.Column="1"/>
        </Grid>

        <!-- Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Buscar:" 
                       Margin="5,0"
                       VerticalAlignment="Center"
                       FontSize="16"/>
            <TextBox Text="{Binding BusqNombre, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     Width="200"
                     FontSize="16"
                     VerticalAlignment="Center"
                     Margin="5,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding BeneficiosView}"
                  AutoGenerateColumns="False"
                  SelectedItem="{Binding BeneficioSeleccionado, Mode=TwoWay}"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTextColumn Header="Fecha de creación" Binding="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy}}" Width="1*"/>

                <!-- Columna Activo reutilizando estilo -->
                <DataGridTemplateColumn Header="Activo" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource ActivoTextBlockStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- ContextMenu en filas -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource GlobalDataGridRow}">
                    <Setter Property="Tag"
                            Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Eliminar"
                                          Command="{Binding PlacementTarget.Tag.EliminarBeneficioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
