<UserControl x:Class="SistemaInstituto.Views.CursosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SistemaInstituto.Views"
             mc:Ignorable="d" 
             FontFamily="Segoe UI"
             d:DesignHeight="800" d:DesignWidth="1025">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="Listado de cursos"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="▲ Subir orden"
                        Command="{Binding SubirCursoCommand}"
                        Width="100" Height="35"
                        Margin="0,0,4,0"/>
                <Button Content="▼ Bajar orden"
                        Command="{Binding BajarCursoCommand}"
                        Width="100" Height="35"
                        Margin="0,0,10,0"/>
                <Button Content="Agregar curso"
                        Command="{Binding AgregarCursoCommand}"
                        MinWidth="160"
                        Height="35"
                        FontSize="16"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CursosView}"
                  AutoGenerateColumns="False"
                  SelectedItem="{Binding CursoSeleccionado, Mode=TwoWay}"
                  VirtualizingPanel.IsVirtualizing="False"
                  Margin="0,5,0,0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Índice" Binding="{Binding Orden}" Width="Auto"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTemplateColumn Header="Admite beneficio" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource AplicaBeneficioTextBlockStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource GlobalDataGridRow}">
                    <Setter Property="Tag"
                            Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Editar"
                                          Command="{Binding PlacementTarget.Tag.EditarCursoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>