<Window x:Class="SistemaInstituto.Views.FormArancelesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaInstituto.Views" 
        xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:FormArancelesViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift"
        Title="Carga de aranceles" Height="450" Width="600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Actualizar aranceles" 
                   FontSize="24" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,12"/>

        <!-- Grilla -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding CursosAranceles}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  FontSize="14"
                  IsReadOnly="False"
                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  ColumnWidth="*">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Curso" Binding="{Binding CursoNombre}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Hasta el 10" 
                                    Binding="{Binding HastaEl10, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C}}"/>
                <DataGridTextColumn Header="Del 10 al 30" 
                                    Binding="{Binding Del10Al30, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C}}"/>
                <DataGridTextColumn Header="Mes vencido" 
                                    Binding="{Binding MesVencido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar" 
                    Command="{Binding GuardarCommand}" 
                    Width="100" Height="38"
                    Style="{StaticResource BotonGuardar}"
                    Margin="0,0,10,0"/>
            <Button Content="Cancelar"
                    Width="100" Height="38"
                    Click="Cancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
