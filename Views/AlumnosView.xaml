<UserControl x:Class="SistemaInstituto.Views.AlumnosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SistemaInstituto.ViewModels" 
             xmlns:ut="clr-namespace:SistemaInstituto.Utilities"
             d:DataContext="{d:DesignInstance Type=viewmodels:AlumnosViewModel}"
             mc:Ignorable="d" 
             FontFamily="Bahnschrift"
             d:DesignHeight="800" d:DesignWidth="1025">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Listado de alumnos"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Grid.Column="0"/>

            <Button Content="Agregar alumno"
                    Width="180"
                    Height="30"
                    FontSize="16"
                    Command="{Binding AgregarAlumnoCommand}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Grid.Column="1"/>
        </Grid>

        <!-- Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Buscar:" 
                       Margin="5,0" 
                       VerticalAlignment="Center"
                       FontSize="16"/>
            <TextBox Text="{Binding BusqNombre, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                     Width="200" 
                     VerticalAlignment="Center"
                     FontSize="16"
                     Margin="5,0"/>
            <TextBlock Text="Filtrar por curso:" 
                       Margin="10,0,5,0"
                       VerticalAlignment="Center"
                       FontSize="16"/>
            <ComboBox DisplayMemberPath="Nombre"
                      SelectedItem="{Binding CursoFiltrado, Mode=TwoWay}"
                      ItemsSource="{Binding Cursos}"
                      Width="200"
                      FontSize="16"
                      Margin="5,0"/>
            <CheckBox Content="Ver inactivos"
                      Command="{Binding ToggleInactivosCommand}"
                      Margin="10,0,0,0"
                      FontSize="16"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding AlumnosView}" 
                  AutoGenerateColumns="False" 
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTemplateColumn Header="Estado" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding IdEstadoNavigation.Nombre}" />
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IdEstadoNavigation.Nombre}" Value="Activo">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Curso" Binding="{Binding IdCursoNavigation.Nombre}" Width="1.5*"/>
                <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="ToolTip" Value="{Binding Notas}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding CantRegistros, StringFormat='Cantidad de registros: {0}'}" 
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,5,0,0"/>
    </Grid>
</UserControl>
