<Window x:Class="SistemaInstituto.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SistemaInstituto.Views"
        xmlns:vm="clr-namespace:SistemaInstituto.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        Title="Sistema Instituto Mandela"
        MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú lateral ahora con tamaño adaptable -->
            <ColumnDefinition Width="Auto" MinWidth="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral -->
        <Border Grid.Column="0" Background="#28A498">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Text="Menú"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Botones -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" Command="{Binding MostrarAlumnosCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Account" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver alumnos"/>
                            </StackPanel>
                        </Button>

                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" Command="{Binding MostrarPagosCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="NotebookOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver pagos"/>
                            </StackPanel>
                        </Button>

                        <Button FontSize="14" Margin="0,5" MinHeight="40" Padding="8" Command="{Binding MostrarMovimientosCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver movimientos"/>
                            </StackPanel>
                        </Button>

                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" Command="{Binding MostrarArancelesCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver aranceles"/>
                            </StackPanel>
                        </Button>

                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" Command="{Binding MostrarBeneficiosCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver beneficios"/>
                            </StackPanel>
                        </Button>

                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" Command="{Binding MostrarCursosCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HumanMaleBoard" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Ver cursos"/>
                            </StackPanel>
                        </Button>


                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" 
                                Background="#ACECE5" Command="{Binding MostrarSeleccionPagoCommand}" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Agregar pago" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>


                        <Button FontSize="16" Margin="0,5" MinHeight="40" Padding="8" Background="#FFD700" Command="{Binding ExportarPdfCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ExportVariant" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Exportar"/>
                            </StackPanel>
                        </Button>
                        
                        
                        
                    </StackPanel>
                </ScrollViewer>

                <!-- Versión -->
                <TextBlock Grid.Row="2"
                           Text="v26.4"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"/>
            </Grid>
        </Border>

        <!-- Contenido dinámico -->
        <ContentControl Grid.Column="1" Content="{Binding VistaActual}" Margin="10"/>
    </Grid>
</Window>
